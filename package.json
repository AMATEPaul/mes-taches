{
  "name": "mes-taches",
  "version": "1.0.0",
  "description": "Mes tâches classées par priorité : Immédiate, Prioritaire, Important, Ça va.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.perso.mestaches",
    "productName": "Mes Tâches",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Mes Tâches",
      "artifactName": "MesTaches-Installation-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MesTaches-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "sortablejs": "^1.15.7"
  }
}
